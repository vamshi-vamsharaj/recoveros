generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum CheckoutSessionStatus {
  STARTED
  ABANDONED
  COMPLETED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  PAUSED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  OVERDUE
  VOID
}

enum MandateStatus {
  ACTIVE
  PAUSED
  REVOKED
  EXPIRED
}

// Where a RecoveryCase originated from. Only PAYMENT is used by the
// payment-degradation workflow implemented in Milestone 2. The others
// exist so the schema does not need to change when future workflows
// (checkout-dropoff, subscription-failure, invoice-overdue, mandate-retry)
// are added.
enum RecoveryCaseSourceType {
  PAYMENT
  CHECKOUT_SESSION
  SUBSCRIPTION
  INVOICE
  MANDATE
}

enum RecoveryCaseStatus {
  DETECTED
  RECOMMENDED
  APPROVED
  EXECUTING
  RECOVERED
  BLOCKED
  FAILED
}

enum RecoveryStrategy {
  PAYMENT_LINK
  RETRY_CARD
  SEND_REMINDER
  OFFER_DISCOUNT
  ALTERNATE_METHOD
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

enum PolicyEvaluationResult {
  APPROVED
  BLOCKED
}

enum RecoveryAttemptStatus {
  EXECUTING
  RECOVERED
  FAILED
}

enum PromiseToPayStatus {
  PENDING
  KEPT
  BROKEN
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum AuditEventType {
  RECOVERY_CASE_CREATED
  DECISION_CREATED
  POLICY_EVALUATED
  ACTION_APPROVED
  ACTION_BLOCKED
  EXECUTION_STARTED
  EXECUTION_COMPLETED
  RECOVERY_VERIFIED
  // Milestone 4 additions -- webhook ingestion/processing audit trail.
  // Gemini fallback (Milestone 3) deliberately does NOT get a new
  // event type here: it's recorded in RecoveryDecision.rawOutput,
  // which the existing DECISION_CREATED event already references.
  WEBHOOK_RECEIVED
  WEBHOOK_DUPLICATE_IGNORED
  WEBHOOK_SIGNATURE_INVALID
  WEBHOOK_PROCESSED
}

// ============================================================
// CORE / MERCHANT DOMAIN
// ============================================================

model Merchant {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers         Customer[]
  payments          Payment[]
  checkoutSessions  CheckoutSession[]
  subscriptions     Subscription[]
  invoices          Invoice[]
  mandates          Mandate[]
  policies          Policy[]
  recoveryCases     RecoveryCase[]
  webhookEvents     WebhookEvent[]
}

model Customer {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  name       String
  email      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  payments         Payment[]
  checkoutSessions CheckoutSession[]
  subscriptions    Subscription[]
  invoices         Invoice[]
  mandates         Mandate[]
  recoveryCases    RecoveryCase[]
  promisesToPay    PromiseToPay[]

  @@index([merchantId])
}

// ============================================================
// REVENUE ENTITIES
// ============================================================

model Payment {
  id            String        @id @default(cuid())
  merchantId    String
  merchant      Merchant      @relation(fields: [merchantId], references: [id])
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  amount        Int
  currency      String        @default("INR")
  status        PaymentStatus
  failureReason String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  recoveryCases RecoveryCase[]

  @@index([merchantId])
  @@index([customerId])
  @@index([status])
}

model CheckoutSession {
  id         String                 @id @default(cuid())
  merchantId String
  merchant   Merchant               @relation(fields: [merchantId], references: [id])
  customerId String?
  customer   Customer?              @relation(fields: [customerId], references: [id])
  amount     Int
  currency   String                 @default("INR")
  status     CheckoutSessionStatus  @default(STARTED)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@index([merchantId])
  @@index([customerId])
  @@index([status])
}

model Subscription {
  id               String              @id @default(cuid())
  merchantId       String
  merchant         Merchant            @relation(fields: [merchantId], references: [id])
  customerId       String
  customer         Customer            @relation(fields: [customerId], references: [id])
  planName         String
  amount           Int
  currency         String              @default("INR")
  status           SubscriptionStatus  @default(ACTIVE)
  currentPeriodEnd DateTime
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([merchantId])
  @@index([customerId])
  @@index([status])
}

model Invoice {
  id         String        @id @default(cuid())
  merchantId String
  merchant   Merchant      @relation(fields: [merchantId], references: [id])
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id])
  amount     Int
  currency   String        @default("INR")
  status     InvoiceStatus @default(OPEN)
  dueDate    DateTime
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([merchantId])
  @@index([customerId])
  @@index([status])
}

model Mandate {
  id         String        @id @default(cuid())
  merchantId String
  merchant   Merchant      @relation(fields: [merchantId], references: [id])
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id])
  status     MandateStatus @default(ACTIVE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([merchantId])
  @@index([customerId])
  @@index([status])
}

// ============================================================
// RECOVERY DOMAIN
// ============================================================

// A RecoveryCase represents revenue at risk. It is created by a
// detection routine (Milestone 2: FAILED payments) and tracked
// through decision -> policy -> execution -> verification.
model RecoveryCase {
  id              String                  @id @default(cuid())
  merchantId      String
  merchant        Merchant                @relation(fields: [merchantId], references: [id])
  customerId      String
  customer        Customer                @relation(fields: [customerId], references: [id])
  sourceType      RecoveryCaseSourceType
  paymentId       String?
  payment         Payment?                @relation(fields: [paymentId], references: [id])
  status          RecoveryCaseStatus      @default(DETECTED)
  amount          Int
  currency        String                  @default("INR")
  recoveredAmount Int?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  decisions     RecoveryDecision[]
  attempts      RecoveryAttempt[]
  auditLogs     AuditLog[]
  promisesToPay PromiseToPay[]

  @@index([merchantId])
  @@index([customerId])
  @@index([paymentId])
  @@index([status])
}

// A recommendation produced by a DecisionProvider (Milestone 2:
// StubDecisionProvider). A RecoveryDecision can exist without a
// RecoveryAttempt -- this happens when its PolicyEvaluation is BLOCKED.
model RecoveryDecision {
  id             String           @id @default(cuid())
  recoveryCaseId String
  recoveryCase   RecoveryCase     @relation(fields: [recoveryCaseId], references: [id])
  strategy       RecoveryStrategy
  reason         String
  confidence     ConfidenceLevel
  providerName   String
  rawOutput      Json
  createdAt      DateTime         @default(now())

  policyEvaluation PolicyEvaluation?
  attempts         RecoveryAttempt[]

  @@index([recoveryCaseId])
}

model Policy {
  id          String   @id @default(cuid())
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id])
  name        String
  isEnabled   Boolean  @default(true)
  maxAttempts Int      @default(3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  evaluations PolicyEvaluation[]

  @@index([merchantId])
}

// Every RecoveryDecision must be evaluated exactly once against a
// Policy. This record is the sole gate between a decision and execution.
model PolicyEvaluation {
  id                 String                 @id @default(cuid())
  recoveryDecisionId String                 @unique
  recoveryDecision   RecoveryDecision       @relation(fields: [recoveryDecisionId], references: [id])
  policyId           String
  policy             Policy                 @relation(fields: [policyId], references: [id])
  result             PolicyEvaluationResult
  reason             String
  createdAt          DateTime               @default(now())

  attempts RecoveryAttempt[]

  @@index([policyId])
  @@index([result])
}

// Created only when a PolicyEvaluation result is APPROVED and the
// Recovery Orchestrator has invoked an adapter (Milestone 2: SimulatedAdapter).
model RecoveryAttempt {
  id                 String                 @id @default(cuid())
  recoveryCaseId     String
  recoveryCase       RecoveryCase           @relation(fields: [recoveryCaseId], references: [id])
  recoveryDecisionId String
  recoveryDecision   RecoveryDecision       @relation(fields: [recoveryDecisionId], references: [id])
  policyEvaluationId String
  policyEvaluation   PolicyEvaluation       @relation(fields: [policyEvaluationId], references: [id])
  adapterName        String
  status             RecoveryAttemptStatus  @default(EXECUTING)
  recoveredAmount    Int?
  // Milestone 4 additions. Nullable/additive -- SimulatedAdapter never
  // sets these, so Milestone 2 rows and behavior are unaffected.
  // providerReference: external id from the adapter's provider (e.g. a
  // Razorpay Payment Link id, "plink_..."), set by RazorpayAdapter and
  // used by workers/webhook.worker.ts to find this attempt again when
  // a payment_link.paid webhook confirms (or payment_link.expired /
  // cancelled denies) recovery.
  providerReference  String?
  providerMetadata   Json?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([recoveryCaseId])
  @@index([recoveryDecisionId])
  @@index([policyEvaluationId])
  @@index([providerReference])
}

model PromiseToPay {
  id             String             @id @default(cuid())
  recoveryCaseId String?
  recoveryCase   RecoveryCase?      @relation(fields: [recoveryCaseId], references: [id])
  customerId     String
  customer       Customer           @relation(fields: [customerId], references: [id])
  amount         Int
  promisedDate   DateTime
  status         PromiseToPayStatus @default(PENDING)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([recoveryCaseId])
  @@index([customerId])
}

model WebhookEvent {
  id          String             @id @default(cuid())
  merchantId  String?
  merchant    Merchant?          @relation(fields: [merchantId], references: [id])
  source      String
  eventType   String
  // Milestone 4 addition. The DB-level uniqueness constraint IS the
  // dedup mechanism for webhook ingestion (webhooks/razorpay.webhook.ts
  // relies on the resulting P2002 error, not an in-memory check).
  // Populated from the X-Razorpay-Event-Id header when present, else a
  // sha256 of the raw body as a best-effort fallback. Nullable so this
  // stays additive for any other/older WebhookEvent rows.
  externalId  String?            @unique
  payload     Json
  status      WebhookEventStatus @default(RECEIVED)
  createdAt   DateTime           @default(now())
  processedAt DateTime?

  @@index([merchantId])
  @@index([status])
}

// Append-only trail of every important transition in the recovery
// pipeline. See AuditEventType for the full set of recorded events.
model AuditLog {
  id             String         @id @default(cuid())
  recoveryCaseId String?
  recoveryCase   RecoveryCase?  @relation(fields: [recoveryCaseId], references: [id])
  eventType      AuditEventType
  actor          String
  metadata       Json
  createdAt      DateTime       @default(now())

  @@index([recoveryCaseId])
  @@index([eventType])
}
